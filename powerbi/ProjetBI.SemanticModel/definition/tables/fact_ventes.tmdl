table fact_ventes
	lineageTag: 131b51b0-69e0-4a00-a6d1-e0800aa98872

	measure CA = CALCULATE ( SUM ( fact_ventes[chiffre_affaires] ), fact_ventes[statut_commande] <> "Cancelled" )
		formatString: #,0
		lineageTag: 63d148f5-e0fa-4dac-88be-4f4519d64d13

	measure 'Marge brute' = CALCULATE ( SUM ( fact_ventes[marge_brute] ), fact_ventes[statut_commande] <> "Cancelled" )
		formatString: #,0
		lineageTag: 578d968e-8a7e-446d-8dc8-bcc091bec3c3

	measure 'Taux de marge' = DIVIDE ( [Marge brute], [CA] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 54a0409a-538e-4fb2-a9ac-a3f02418e714

	measure 'Quantité vendue' = CALCULATE ( SUM ( fact_ventes[quantite] ), fact_ventes[statut_commande] <> "Cancelled" )
		formatString: #,0
		lineageTag: 392088ef-5dce-4b3e-8252-e610e639cd20

	measure 'CA N-1' = CALCULATE ( [CA], SAMEPERIODLASTYEAR ( dim_date[date_complete] ) )
